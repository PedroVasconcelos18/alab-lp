# Supabase — pegue em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Service role: SÓ no servidor, NUNCA exponha no client (sem prefixo NEXT_PUBLIC_).
# Usado apenas em rotas/admin server-side se necessário. Mantenha em segredo.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# URL pública do site (usada para montar links de share e callback de OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
