{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://blog-production-b190.up.railway.app/"
    },
    {
      "source": "/blog/:caminho(.*)",
      "destination": "https://blog-production-b190.up.railway.app/:caminho"
    }
  ]
}
