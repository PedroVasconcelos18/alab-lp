{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/produtos",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://blog-production-b190.up.railway.app/"
    },
    {
      "source": "/blog/:caminho(.*)",
      "destination": "https://blog-production-b190.up.railway.app/:caminho"
    }
  ]
}
